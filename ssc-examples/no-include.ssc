
object NoInclude
{
    private int a, b, c;
    long l;

    void init()
    {
        auto lambda = | [ int num, int mul ] | --> long
        {
            const int i = 1;
            ( void ) i;
            return num * mul;
        };
        | [ int c, ... ] | --> void
        {
            const int i = lambda( 4, 4 );
            return;
        };

        this->a = this->b = this->c = this->l = lambda( 123, 2 );
    }
};

int main( void )
{
    object NoInclude obj;
    obj.init();

    return ( int ) obj.l;
}
