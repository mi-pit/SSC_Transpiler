
object First
{
    private bool b;

    bool is() { return this->b; }
};

object Second
{
    private int n;

    int get() { return this->n; }
};


int main( int argc, char **argv )
{
    if ( argc == 1 )
    {
        ( void ) argv;
        object First o = {};
        if ( o.is() )
            return 1;
    }

    object Second o = {};
    return o.get();
}
