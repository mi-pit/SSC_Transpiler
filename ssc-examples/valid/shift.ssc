
tmpl<A, B>
object Thing
{
    A t;
    B b;
};

#ifdef __SSC_SOURCE__
    object
#else
    struct
#endif
    Other
{
#ifdef __SSC_SOURCE__
    private
#endif
    bool b;
};

int main()
{
    object Thing<int, bool> it =
    {
        .t = 1,
    };
    object Thing<struct Other, object Thing<int, bool>> tt; // `>>` does NOT get parsed as the shift operator

    while (it.t < 9'999) {
        it.t >>= 1;
        it.b = 1'000'000 << it.t >> 1; // `>>` DOES get parsed as the shift operator
    }

    return tt.b.t > 9999;
}
