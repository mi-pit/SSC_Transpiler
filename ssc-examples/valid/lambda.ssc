#include <ssclib.ssch>

void test_array()
{
    int array[ 1024 ] = {};
    for ( size_t i = 0; i < 1024; ++i )
        array[ i ] = rand();

    qsort(
            array, countof( array ), sizeof( int ),
            | [ const void * a, const void * b ] | --> int {
                  int x = *( const int * ) a, y = *( const int * ) b;
                  return if x > y then 1 else if x < y then - 1 else 0;
              } );

    array_printf( array, 1024, int, "%i" );
}
void test_nested();

int main()
{
    const auto is_underscore = | [ char c, int * count ] | --> bool
    {
        if ( c == '_' )
        {
            ++( *count );
            return true;
        }
        return false;
    };

    int underscore_count = 0;

    const char *str = "Abcdefg_!";
    for ( unsigned long i = 0; i < sizeof str; ++i )
    {
        printf( "Underscore " );
        if ( is_underscore( str[ i ], &underscore_count ) )
            printf( "found" );
        else
            printf( "not found" );
        printf( " at char %c\n", str[ i ] );
    }

    printf( "Found %i underscore(s)\n", underscore_count );

    test_array();
    test_nested();

    return 1;
}

void test_nested()
{
    const auto outer = | [ size_t c, ... ] | --> int
    {
        const auto inner = | [void] | --> int
        {
            return 123;
        };

        va_list vl;
        va_start( vl, c );

        int n = inner();
        for ( size_t i = 0; i < c; ++i )
            n += va_arg( vl, int );

        va_end( vl );

        return n;
    };

    println( "Should be 123: %i", outer( 3u, 1, 2, 3 ) );
}
